rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'remainingSeconds',
          'activeUntilMs',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'demoBalanceCop',
          'remainingSeconds',
          'activeUntilMs',
          'autoOffAtMs',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 120
        && (!('demoBalanceCop' in data) || (data.demoBalanceCop is number && data.demoBalanceCop >= 0 && data.demoBalanceCop <= 10000000))
        && data.remainingSeconds is number && data.remainingSeconds >= 0 && data.remainingSeconds <= 31536000
        && data.activeUntilMs is number && data.activeUntilMs >= 0
        && (!('autoOffAtMs' in data) || (data.autoOffAtMs is number && data.autoOffAtMs >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPaymentStatus(status) {
      return status is string
        && status.size() <= 24
        && status in ['APPROVED', 'DECLINED', 'VOIDED', 'ERROR'];
    }

    function isValidDiscountTier(hours, discountPercent) {
      return (hours >= 1 && hours <= 5 && discountPercent == 0)
        || (hours >= 6 && hours <= 11 && discountPercent == 10)
        || (hours >= 12 && hours <= 23 && discountPercent == 20)
        || (hours == 24 && discountPercent == 30);
    }

    function isValidPaywallPlanPricing(data) {
      return (data.hours == 1 && data.subtotalCop == 5000 && data.discountPercent == 0 && data.discountCop == 0 && data.totalCop == 5000)
        || (data.hours == 6 && data.subtotalCop == 30000 && data.discountPercent == 10 && data.discountCop == 3000 && data.totalCop == 27000)
        || (data.hours == 12 && data.subtotalCop == 60000 && data.discountPercent == 20 && data.discountCop == 12000 && data.totalCop == 48000)
        || (data.hours == 24 && data.subtotalCop == 120000 && data.discountPercent == 30 && data.discountCop == 36000 && data.totalCop == 84000);
    }

    function isValidPaymentRecord(data, userId, paymentId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'reference',
          'transactionId',
          'hours',
          'addedSeconds',
          'subtotalCop',
          'discountPercent',
          'discountCop',
          'totalCop',
          'amountInCents',
          'currency',
          'status',
          'isDemo',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'reference',
          'transactionId',
          'hours',
          'addedSeconds',
          'subtotalCop',
          'discountPercent',
          'discountCop',
          'totalCop',
          'amountInCents',
          'currency',
          'status',
          'isDemo',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == paymentId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && isValidId(data.reference)
        && data.reference == paymentId
        && data.transactionId is string && data.transactionId.size() <= 128
        && data.hours is number && data.hours >= 1 && data.hours <= 24
        && data.addedSeconds is number && data.addedSeconds == data.hours * 3600
        && data.subtotalCop is number
        && data.discountPercent is number
        && data.discountCop is number && data.discountCop >= 0 && data.discountCop <= data.subtotalCop
        && data.totalCop is number && data.totalCop == data.subtotalCop - data.discountCop && data.totalCop > 0
        && (
          isValidPaywallPlanPricing(data)
          || (data.subtotalCop == data.hours * 5000 && isValidDiscountTier(data.hours, data.discountPercent))
        )
        && data.amountInCents is number && data.amountInCents == data.totalCop * 100
        && data.currency is string && data.currency.size() <= 8 && data.currency == 'COP'
        && isValidPaymentStatus(data.status)
        && data.status == 'APPROVED'
        && data.isDemo is bool && data.isDemo == false
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommandLog(data, userId, commandId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'action',
          'ok',
          'summary',
          'tuyaCode',
          'tuyaTid',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'action',
          'ok',
          'summary',
          'tuyaCode',
          'tuyaTid',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.id == commandId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.action is string && data.action.size() <= 24 && data.action in ['PRENDER', 'APAGAR', 'ESTADO', 'PAGO']
        && data.ok is bool
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && data.tuyaCode is string && data.tuyaCode.size() <= 64
        && data.tuyaTid is string && data.tuyaTid.size() <= 128
        && data.createdAt is timestamp;
    }

    // Private User Profile (PII isolated strictly to owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().remainingSeconds == 0
        && incoming().activeUntilMs == 0
        && !('demoBalanceCop' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['remainingSeconds', 'activeUntilMs', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['remainingSeconds', 'activeUntilMs', 'autoOffAtMs', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'remainingSeconds', 'activeUntilMs', 'autoOffAtMs', 'updatedAt']) ||
          (
            !('demoBalanceCop' in incoming())
            && 'demoBalanceCop' in existing()
            && incoming().diff(existing()).affectedKeys().hasOnly(['demoBalanceCop', 'displayName', 'remainingSeconds', 'activeUntilMs', 'autoOffAtMs', 'updatedAt'])
          )
        );

      allow delete: if false;

      // Per-user Verified Wompi Payment Records (Immutable, Master Gate verifies parent user exists)
      match /payments/{paymentId} {
        allow get: if isValidId(userId) && isValidId(paymentId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(paymentId)
          && isOwner(userId)
          && isValidPaymentRecord(incoming(), userId, paymentId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if false;
      }

      // Per-user Command & Activity History (Append-only, Master Gate verifies parent user exists)
      match /commands/{commandId} {
        allow get: if isValidId(userId) && isValidId(commandId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(commandId)
          && isOwner(userId)
          && isValidCommandLog(incoming(), userId, commandId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(commandId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
